CGIPassAuth on

<IfModule mod_headers.c>
	Header set Access-Control-Allow-Origin "*"
	Header set Access-Control-Allow-Headers "*, Authorization"
	Header set Access-Control-Allow-Methods "GET, POST, PATCH, PUT, DELETE, OPTIONS, HEAD"
	Header set X-Robots-Tag "noindex, nofollow"
</IfModule>

# Fallback für Server ohne mod_rewrite: Verwende index.php als Router
<IfModule !mod_rewrite.c>
    # Wenn mod_rewrite nicht verfügbar ist, leite alles an index.php
    ErrorDocument 404 /index.php
</IfModule>

<IfModule mod_rewrite.c>
	RewriteEngine on
	RewriteBase /

	# Authorization Header explizit durchreichen (Fallback für FastCGI)
	RewriteCond %{HTTP:Authorization} ^(.*)
	RewriteRule ^ - [E=HTTP_AUTHORIZATION:%1]

	# Falls eine Webserver-Konfiguration den Authorization-Header durch ein Redirect verändert hat, dann benenne ihn wieder um
	RewriteCond %{ENV:HTTP_AUTHORIZATION} ^$
	RewriteCond %{ENV:REDIRECT_HTTP_AUTHORIZATION} ^(.*)
	RewriteRule ^ - [E=HTTP_AUTHORIZATION:%1]

	# respond with 404 on incoming URLs with .php
	RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
	RewriteRule ^ /%0 [R=404,NE,L]
	
	# Wenn die Datei nicht existiert und kein Verzeichnis ist, dann prüfe, ob eine .php existiert mit dem Namen existiert und leite dann weiter
	RewriteCond %{DOCUMENT_ROOT}/$1 !-f
	RewriteCond %{DOCUMENT_ROOT}/$1 !-d
	RewriteCond %{DOCUMENT_ROOT}/$1.php -f
	RewriteRule ^(.+?)/?$ $1.php [L]

</IfModule>

