{
	"name": "@svws-nrw/tests-server-enm",
	"description": "SVWS-Server-Projekt: ENM-Server Tests",
	"author": "MSB NRW",
	"license": "BSD-3-Clause",
	"version": "1.4.1",
	"type": "module",
	"scripts": {
		"test:setup": "vitest run ./tests/setup --mode allowDestructiveTests --outputFile build/test-results/setup-test-results.xml",
		"test:sync": "vitest run ./tests/sync --mode allowDestructiveTests --outputFile build/test-results/sync-test-results.xml",
		"test:afterSetup": "vitest run ./tests/afterSetup --mode allowDestructiveTests --outputFile build/test-results/after-setup-test-results.xml",
		"test:tempDockerEnv": "vitest run ./tests --mode allowDestructiveTests ",
		"lint": "eslint 'tests/**/*.{ts,vue}' --cache --max-warnings=0",
		"test:ts": "tsc --noEmit",
		"lint-fix": "eslint 'tests/**/*.{ts,vue}' --cache --fix"
	}
}
