{
	"author": "MSB NRW",
	"name": "svws-monorepo",
	"description": "SVWS-Server-Projekt: Monorepo-Workspace",
	"version": "1.4.1",
	"license": "BSD-3-Clause",
	"type": "module",
	"scripts": {
		"lint": "npm run lint --workspaces --if-present --workspace=svws-webclient/admin --workspace=svws-webclient/client --workspace=svws-webclient/enmserver --workspace=svws-webclient/laufbahnplanung --workspace=svws-webclient/ui",
		"test": "npm run test --workspace=svws-webclient/ui",
		"test:coverage": "npm run test:coverage --workspace=svws-webclient/ui",
		"test:ts": "npm run test:ts --workspaces --if-present --workspace=svws-webclient/admin --workspace=svws-webclient/client --workspace=svws-webclient/enmserver --workspace=svws-webclient/laufbahnplanung --workspace=svws-webclient/ui",
		"ci": "npm run lint && npm run test:ts && npm run test:coverage",
		"admin:ci": "npm run ci --workspace=svws-webclient/admin && npm run ci --workspace=svws-webclient/ui",
		"client:ci": "npm run ci --workspace=svws-webclient/client && npm run ci --workspace=svws-webclient/ui",
		"enmserver:ci": "npm run ci --workspace=svws-webclient/enmserver && npm run ci --workspace=svws-webclient/ui",
		"laufbahnplanung:ci":"npm run ci --workspace=svws-webclient/laufbahnplanung && npm run ci --workspace=svws-webclient/ui",
		"ui:ci": "npm run ci --workspace=svws-webclient/ui"
	},
	"dependencies": {
		"@floating-ui/vue": "^2.0.0",
		"@headlessui/vue": "^1.7.7",
		"markdown-exit": "^1.1.0-beta.2",
		"vue-router": "^5.0.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@stylistic/eslint-plugin": "^5.0.0",
		"@tailwindcss/typography": "^0.5.9",
		"@tailwindcss/vite": "^4.0.17",
		"@types/eslint__js": "^8.42.3",
		"@types/node": "^26.0.0",
		"@typescript-eslint/eslint-plugin": "^8.0.0-alpha.30",
		"@typescript-eslint/parser": "^8.0.0-alpha.30",
		"@vitejs/plugin-basic-ssl": "^2.3.0",
		"@vitejs/plugin-vue": "^6.0.0",
		"@vitest/coverage-v8": "^4.0.1",
		"@vue/devtools-api": "^8.1.2",
		"@vue/test-utils": "^2.4.6",
		"@vue/tsconfig": "^0.9.0",
		"@vueuse/core": "^14.0.0",
		"eslint": "^10.0.1",
		"eslint-plugin-vue": "^10.0.0",
		"globals": "^17.3.0",
		"happy-dom": "^20.0.0",
		"remixicon": "^4.2.0",
		"tailwindcss": "^4.0.17",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.0.0-alpha.30",
		"unplugin-auto-import": "^21.0.0",
		"unplugin-vue-components": "^32.0.0",
		"unplugin-vue-markdown": "^32.0.0",
		"vite": "^8.0.0",
		"vitest": "^4.0.1",
		"vue-component-type-helpers": "^3.1.5",
		"vue-tsc": "^3.3.3"
	},
	"peerDependencies": {
		"vue": "^3.4.13"
	},
	"engines": {
		"node": ">=20.6.0",
		"npm": ">=10.5.0"
	},
	"workspaces": [
		"svws-webclient/admin",
		"svws-webclient/client",
		"svws-webclient/core",
		"svws-webclient/enmserver",
		"svws-webclient/laufbahnplanung",
		"svws-webclient/ui",
		"tests/tests-server-api",
		"tests/tests-server-dav",
		"tests/tests-server-enm"
	]
}
